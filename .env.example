# Supabase projesinin Connect bölümündeki Project URL ve Publishable key.
# EXPO_PUBLIC_ değişkenleri uygulamanın içinde görünür; gizli anahtar koymayın.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# FastAPI; yalnızca yeni migration'lar ve backend hazır olduktan sonra etkinleştirin.
# Telefon testinde localhost yerine bilgisayarın yerel IP adresi kullanılır.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_MEMORY_API_ENABLED=false
# Yalnızca development derlemesinde gösterilir. Backend simülasyon ayarı da açık olmalıdır.
EXPO_PUBLIC_ANALYSIS_SIMULATION_ENABLED=false
