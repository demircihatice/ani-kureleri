APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
ANALYSIS_SIMULATION_ENABLED=false

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Boş bırakıldığında SUPABASE_URL + /auth/v1 kullanılır.
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
# Native mobil istekleri CORS gerektirmez. Web gerekirse açık origin ekleyin.
CORS_ORIGINS=[]

# Ayrı DB rolleri; gerçek bağlantıları yalnızca backend/.env'e girin.
# postgresql+asyncpg://app_runtime:PERCENT_ENCODED_PASSWORD@HOST:5432/postgres
# Session pooler kullanıcı adı: app_runtime.PROJECT_REF
DATABASE_RUNTIME_URL=
DATABASE_MIGRATION_URL=
# Yalnızca direct veya session. Transaction pooler / port 6543 desteklenmez.
DATABASE_CONNECTION_MODE=session
# Gerekirse Dashboard'dan alınan CA sertifikasının yerel yolu; boşsa sistem CA kullanılır.
DATABASE_SSL_CA_FILE=
DATABASE_POOL_SIZE=2
# /v1/db-check production ortamında bu ayara rağmen kapalıdır.
DB_CHECK_ENABLED=false
# Canlı şema denetimi yapılmadan true yapmayın; Alembic online işlemlerini kilitler.
ALEMBIC_BASELINE_CONFIRMED=false
